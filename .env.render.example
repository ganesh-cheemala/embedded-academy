# Render deployment values. Set these in the Render dashboard or Blueprint sync.
ACADEMY_ENV=production
ACADEMY_COOKIE_SECURE=1
ACADEMY_TRUSTED_HOSTS=*
ACADEMY_BASE_URL=https://YOUR-SERVICE.onrender.com
ACADEMY_SECRET=generate-a-long-random-secret
ACADEMY_ADMIN_PASSWORD=choose-a-strong-password
# DATABASE_URL is injected from the Render Postgres service by render.yaml.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
