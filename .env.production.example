# Copy to .env on the production server and replace every placeholder.
POSTGRES_PASSWORD=replace-with-a-long-random-password
ACADEMY_SECRET=replace-with-a-long-random-secret
ACADEMY_ADMIN_PASSWORD=replace-with-a-strong-admin-password
ACADEMY_ENV=production
ACADEMY_COOKIE_SECURE=1
ACADEMY_BASE_URL=https://academy.example.com
ACADEMY_TRUSTED_HOSTS=academy.example.com
LOG_LEVEL=INFO
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=academy@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Embedded Academy <academy@example.com>
SMTP_TLS=1
